{
  "name": "agent-moringgroove",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Folder-based multi-agent manager: tree, knowledge graph, per-folder Claude agents, MCP/skills, herdr CLI view",
  "scripts": {
    "start": "node serve.mjs",
    "test": "node --test test/*.test.mjs",
    "build": "esbuild src/editor.js src/term.js --bundle --format=esm --splitting --minify --outdir=public/vendor && cp node_modules/@xterm/xterm/css/xterm.css public/vendor/xterm.css",
    "prestart": "test -f public/vendor/editor.js || npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.16",
    "force-graph": "^1.52.0",
    "marked": "^18.1.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
